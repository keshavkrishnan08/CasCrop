# CasCrop API Keys
# Copy this file to .env and fill in your keys
# All keys are free to obtain — instructions below

# USDA NASS Quick Stats API Key
# Get yours at: https://quickstats.nass.usda.gov/api
# Click "Request API Key" — instant, no approval needed
NASS_API_KEY=

# NOAA Climate Data Online API Token
# Get yours at: https://www.ncdc.noaa.gov/cdo-web/token
# Enter email, token emailed within minutes
NOAA_API_TOKEN=

# FRED (Federal Reserve Economic Data) API Key
# Get yours at: https://fred.stlouisfed.org/docs/api/api_key.html
# Free account required
FRED_API_KEY=

# Google Earth Engine (for Sentinel-2 / Landsat)
# Sign up at: https://earthengine.google.com/signup/
# Run `earthengine authenticate` after approval
# No key needed here — uses OAuth
GEE_PROJECT=

# NASA Earthdata (for SMAP soil moisture)
# Register at: https://urs.earthdata.nasa.gov/users/new
# Free account
NASA_EARTHDATA_USER=
NASA_EARTHDATA_PASS=

# Weights & Biases (optional — for experiment tracking)
# Get yours at: https://wandb.ai/settings
WANDB_API_KEY=
WANDB_PROJECT=cascrop
